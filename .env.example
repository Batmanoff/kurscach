# === Flask API ===
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-too
DATABASE_URL=postgresql+psycopg://fashion:fashion@localhost:5432/fashion_store
# Local SQLite fallback (used automatically if DATABASE_URL is empty):
# DATABASE_URL=sqlite:///fashion_store.db
# Optional — leave empty for in-memory rate limits (recommended on Windows without Redis)
REDIS_URL=
CORS_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Admin seed (created on first boot / seed script)
ADMIN_EMAIL=admin@atelier.dev
ADMIN_PASSWORD=Admin123!

# Demo customer
DEMO_EMAIL=demo@atelier.dev
DEMO_PASSWORD=Demo123!

# === YooKassa (SBP) ===
# Leave empty to enable mock payments (QR + confirmation URL without real charge)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/success
YOOKASSA_WEBHOOK_SECRET=

# Rate limiting
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_AUTH=20 per minute

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_STORE_NAME=ATELIER
NEXT_PUBLIC_CURRENCY=RUB
