# === Локально (курсовая): SQLite, один Flask ===
DATABASE_URL=sqlite:///fashion_store.db
REDIS_URL=

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-too
STORE_NAME=Swaga

# Один и тот же публичный URL сайта (Jinja UI + API)
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

ADMIN_EMAIL=admin@atelier.dev
ADMIN_PASSWORD=Admin123!
DEMO_EMAIL=demo@atelier.dev
DEMO_PASSWORD=Demo123!

# ЮKassa — пусто = mock СБП
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:5000/checkout/success
YOOKASSA_WEBHOOK_SECRET=

RATELIMIT_DEFAULT=120 per minute
RATELIMIT_AUTH=20 per minute

# ПВЗ Яндекс Маркет (опционально; без ключей = демо-seed + iframe карта)
# YANDEX_MAPS_API_KEY=   # JS API placemarks + Geosearch; без ключа — iframe map-widget

# YANDEX_MARKET_API_KEY=
# YANDEX_MARKET_BUSINESS_ID=

# --- HOSTING (пример) ---
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/fashion_store
# BACKEND_URL=https://your-app.example.com
# FRONTEND_URL=https://your-app.example.com
# YOOKASSA_RETURN_URL=https://your-app.example.com/checkout/success
# SECRET_KEY=generate-a-long-random-string
# JWT_SECRET_KEY=another-long-random-string
